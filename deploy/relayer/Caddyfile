# Caddy provisions and renews a Let's Encrypt certificate for the host below on
# its own, as long as the DNS A record points at this VPS and ports 80 and 443
# are reachable. It terminates TLS and reverse-proxies to the relayer daemons,
# which listen on localhost only (never expose 4663/4664 to the public internet).
#
# One relayer per chain, told apart by path rather than by hostname so mainnet
# needs no second DNS record: testnet at the root, mainnet under /mainnet.
# `handle_path` strips the prefix, so each daemon sees /quote and /relay either
# way and the client only ever changes its base URL.

relay.cowlprotocol.com {
	# The browser calls this from another origin, so the preflight has to be
	# answered or the request never leaves the tab.
	#
	# The allow-list is a courtesy, not a wall. CORS binds browsers and nothing
	# else: any server, any curl, can post a spend here already, which is what a
	# public relayer is for. So it covers the deployed app and a dev server on
	# localhost, and refusing anything beyond that only stops a stray page from
	# spending this gas float through a visitor's browser without them asking.
	@allowed header_regexp Origin ^(https://app\.cowlprotocol\.com|http://localhost(:[0-9]+)?|http://127\.0\.0\.1(:[0-9]+)?)$

	@preflight {
		method OPTIONS
		header_regexp Origin ^(https://app\.cowlprotocol\.com|http://localhost(:[0-9]+)?|http://127\.0\.0\.1(:[0-9]+)?)$
	}
	handle @preflight {
		header Access-Control-Allow-Origin "{http.request.header.Origin}"
		header Access-Control-Allow-Methods "GET, POST, OPTIONS"
		header Access-Control-Allow-Headers "content-type"
		header Access-Control-Max-Age "86400"
		header Vary "Origin"
		respond 204
	}

	# Echoed back rather than hard-coded, since a browser only accepts a header
	# that names its own origin exactly.
	header @allowed Access-Control-Allow-Origin "{http.request.header.Origin}"
	header Vary "Origin"

	handle_path /mainnet/* {
		reverse_proxy 127.0.0.1:4664
	}

	handle {
		reverse_proxy 127.0.0.1:4663
	}
}
