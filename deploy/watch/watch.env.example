# Copy to /etc/cowl-watch/watch.env, then: chown root:root && chmod 600.
#
# This URL is a credential. A Discord webhook, a Slack hook and a Telegram bot
# token are all secret in their *path*, so anyone who can read this file can
# post into the channel — and, for Telegram, use the bot. Treat it exactly the
# way /etc/cowl-relayer/relayer.env is treated on the same box.
#
# https is required. The notifier refuses plaintext before a byte leaves the
# machine, because over http:// this line and every address in the alert cross
# the wire in the clear.

# Discord   https://discord.com/api/webhooks/<id>/<token>
# Slack     https://hooks.slack.com/services/<T>/<B>/<token>
# Telegram  https://api.telegram.org/bot<token>/sendMessage   (also set COWL_WATCH_CHAT_ID)
# ntfy      https://ntfy.sh/<a-topic-nobody-can-guess>
# anything  any https endpoint that accepts a JSON POST
COWL_WATCH_WEBHOOK=replace-with-the-webhook-url

# Telegram only.
#COWL_WATCH_CHAT_ID=

# How long the same set of alarms stays quiet before it is repeated. A pending
# verifier swap alarms for seven days; at 15-minute ticks that is 672 identical
# messages, and the 673rd is the one nobody reads. Default 60.
#COWL_WATCH_REPEAT_MINUTES=60

# Force a payload shape when the URL cannot be recognised — a self-hosted
# Mattermost speaking Slack's format, say. One of: slack, discord, telegram,
# ntfy, json.
#COWL_WATCH_SINK=

# Seconds before the watcher is killed and the timeout itself is notified.
# Default 300.
#COWL_WATCH_TIMEOUT=300
