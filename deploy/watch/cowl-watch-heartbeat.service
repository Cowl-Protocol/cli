[Unit]
Description=Cowl watch heartbeat — proves the watch itself is still running
Documentation=https://github.com/Cowl-Protocol/cli/blob/main/audits/monitoring/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=cowl-watch
Group=cowl-watch
WorkingDirectory=/opt/cowl-watch/cli
EnvironmentFile=/etc/cowl-watch/watch.env
Environment=COWL_WATCH_STATE=/var/lib/cowl-watch/state.json
Environment=COWL_WATCH_TMP=/var/lib/cowl-watch/build

# The same check, with the one difference that it speaks when everything is
# fine. A quiet channel and a dead timer are the same observation otherwise, and
# noticing the difference is the entire job of this unit.
ExecStart=/usr/bin/node scripts/notify.mjs --heartbeat --network robinhood-mainnet

TimeoutStartSec=600

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
PrivateDevices=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadWritePaths=/var/lib/cowl-watch
